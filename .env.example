# --- Required ---

# Anthropic API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model to use. Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase project. Get these from Supabase project settings -> API.
# SUPABASE_SERVICE_ROLE_KEY is server-only — never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: Twilio SMS (off by default) ---
# Set TWILIO_ENABLED=true and point your Twilio number's inbound-SMS webhook
# at /api/twilio/sms to text Jarvis directly instead of using the PWA.
TWILIO_ENABLED=false
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=

# --- Optional: higher-quality text-to-speech (off by default) ---
# The PWA uses the free browser Web Speech API for voice by default. Wiring
# ElevenLabs in is a future upgrade path, not required to run Jarvis.
ELEVENLABS_API_KEY=

# --- Optional: read-only integrations (off by default, draft-only) ---
GOOGLE_CALENDAR_ENABLED=false

# The mayday-hub plugin's secret ICS feed URL (MayDay Bookings -> Settings).
# Read-only, no OAuth required.
WORDPRESS_ICS_URL=
