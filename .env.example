# --- Required ---

# Anthropic API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model to use. Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase project. Get these from Supabase project settings -> API.
# SUPABASE_SERVICE_ROLE_KEY is server-only — never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password to open the PWA at all (lock screen). Defaults to "mayday" if
# unset — set this explicitly once you're live so it's not just the default.
APP_PASSWORD=mayday

# --- Optional: reminders via free push notifications (off until configured) ---
# Generate once with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe to expose to the browser (that's the
# point of the public/private split) — VAPID_PRIVATE_KEY is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Shared secret the GitHub Actions reminder-check workflow sends. Generate
# any random string; also add it as a GitHub repo secret named CRON_SECRET,
# plus JARVIS_APP_URL (your deployed URL) — see README.
CRON_SECRET=

# --- Optional: two-way texting with Jarvis over real SMS (off by default) ---
# Separate from reminders (which use free push notifications above). Only
# needed if you want to text Jarvis directly instead of using the PWA.
# Costs money (Twilio phone number + per-message fees).
TWILIO_ENABLED=false
TWILIO_AUTH_TOKEN=

# --- Optional: higher-quality text-to-speech (off by default) ---
# The PWA uses the free browser Web Speech API for voice by default. Wiring
# ElevenLabs in is a future upgrade path, not required to run Jarvis.
ELEVENLABS_API_KEY=

# --- Optional: report cards, live pricing, and live bookings (off until
# configured) --- one key, three tools (submit_report_card,
# wordpress_pricing_read, estimate_monthly_earnings, and the upgraded
# wordpress_bookings_read). Values come from mayday-hub WP admin ->
# MayDay Co. -> Jarvis Integration.
WORDPRESS_API_URL=
WORDPRESS_API_KEY=

# --- Optional: the mayday-hub plugin's secret ICS feed URL, for the
# read-only wordpress_bookings_read tool (MayDay Bookings -> Settings).
WORDPRESS_ICS_URL=

# --- Optional: Google Calendar (off until configured) ---
# Personal OAuth, one-time setup — see README for exact steps. Powers both
# the google_calendar_read tool and automatic event creation when a booking
# is confirmed on the WordPress site.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Shared secret for the inbound booking-confirmed webhook from WordPress
# (/api/webhooks/booking). Generate any random string and paste the SAME
# value into mayday-hub WP admin -> Jarvis Integration -> calendar section.
JARVIS_CALENDAR_WEBHOOK_SECRET=

# --- Optional: Square draft invoices (off until configured) ---
# Uses the SAME Square account already taking booking payments. Get an
# access token at https://developer.squareup.com -> your app -> Credentials
# (use the Production token, not sandbox, unless you want to test first).
# SQUARE_LOCATION_ID is under that app's Locations tab.
# create_invoice ONLY ever creates DRAFTS — it cannot publish or send.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=production

# --- Optional: voice notes (off until configured) ---
# Required for voice input to work AT ALL — the browser's own speech
# recognition is unreliable across platforms (notably broken in an
# installed iOS PWA), so voice notes are recorded and transcribed here
# via OpenAI's Whisper API instead. Get a key at platform.openai.com ->
# API keys. Costs ~$0.006/minute of audio — trivial at personal-use volume.
OPENAI_API_KEY=
