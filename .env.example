# --- Required ---

# Anthropic API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model to use. Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase project. Get these from Supabase project settings -> API.
# SUPABASE_SERVICE_ROLE_KEY is server-only — never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password to open the PWA at all (lock screen). Defaults to "mayday" if
# unset — set this explicitly once you're live so it's not just the default.
APP_PASSWORD=mayday

# --- Optional: Twilio SMS (off by default) ---
# Set TWILIO_ENABLED=true and point your Twilio number's inbound-SMS webhook
# at /api/twilio/sms to text Jarvis directly instead of using the PWA. Same
# flag/credentials also power outbound text reminders (schedule_reminder tool).
TWILIO_ENABLED=false
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=

# Your own phone number (E.164, e.g. +17205551234) — reminders text here.
OWNER_PHONE_NUMBER=

# Shared secret the GitHub Actions reminder-check workflow sends. Generate
# any random string; also add it as a GitHub repo secret named CRON_SECRET,
# plus JARVIS_APP_URL (your deployed URL) — see README.
CRON_SECRET=

# --- Optional: higher-quality text-to-speech (off by default) ---
# The PWA uses the free browser Web Speech API for voice by default. Wiring
# ElevenLabs in is a future upgrade path, not required to run Jarvis.
ELEVENLABS_API_KEY=

# --- Optional: report cards by voice (off until configured) ---
# Values come from mayday-hub WP admin -> MayDay Co. -> Jarvis Integration.
WORDPRESS_API_URL=
WORDPRESS_API_KEY=

# --- Optional: the mayday-hub plugin's secret ICS feed URL, for the
# read-only wordpress_bookings_read tool (MayDay Bookings -> Settings).
WORDPRESS_ICS_URL=

# --- Optional: Google Calendar (off until configured) ---
# Personal OAuth, one-time setup — see README for exact steps. Powers both
# the google_calendar_read tool and automatic event creation when a booking
# is confirmed on the WordPress site.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Shared secret for the inbound booking-confirmed webhook from WordPress
# (/api/webhooks/booking). Generate any random string and paste the SAME
# value into mayday-hub WP admin -> Jarvis Integration -> calendar section.
JARVIS_CALENDAR_WEBHOOK_SECRET=
